{
  "properties": {
    "connectionReferences": {
      "shared_office365": {
        "api": {
          "name": "shared_office365"
        },
        "connection": {
          "id": ""
        },
        "runtimeSource": "invoker"
      },
      "shared_teams": {
        "api": {
          "name": "shared_teams"
        },
        "connection": {
          "id": ""
        },
        "runtimeSource": "invoker"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Wenn_neue_E-Mail_eintrifft": {
          "type": "ApiConnectionNotification",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['shared_office365']['connectionId']"
              }
            },
            "fetch": {
              "method": "get",
              "pathTemplate": {
                "template": "/codeless/subscriptions/Mail/folders/Inbox/messages/onNewEmail"
              },
              "queries": {
                "folderPath": "Inbox",
                "importance": "Any",
                "fetchOnlyWithAttachment": false,
                "includeAttachments": false
              }
            },
            "subscribe": {
              "method": "post",
              "pathTemplate": {
                "template": "/GraphBasedSubscriptions/subscriptions/Mail/folders/Inbox/messages/onNewEmail"
              },
              "queries": {
                "folderPath": "Inbox",
                "importance": "Any",
                "fetchOnlyWithAttachment": false,
                "includeAttachments": false
              }
            }
          },
          "splitOn": "@triggerBody()?['value']"
        }
      },
      "actions": {
        "Init_AnthropicApiKey": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "AnthropicApiKey",
                "type": "String",
                "value": "DEIN_ANTHROPIC_API_KEY_HIER_EINSETZEN"
              }
            ]
          },
          "runAfter": {}
        },
        "Init_SenderEmail": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SenderEmail",
                "type": "String",
                "value": "@triggerBody()?['From']"
              }
            ]
          },
          "runAfter": {
            "Init_AnthropicApiKey": ["Succeeded"]
          }
        },
        "Init_EmailSubject": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "EmailSubject",
                "type": "String",
                "value": "@triggerBody()?['Subject']"
              }
            ]
          },
          "runAfter": {
            "Init_SenderEmail": ["Succeeded"]
          }
        },
        "Init_EmailBody": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "EmailBody",
                "type": "String",
                "value": "@triggerBody()?['Body']"
              }
            ]
          },
          "runAfter": {
            "Init_EmailSubject": ["Succeeded"]
          }
        },
        "Early_Exit_Filter": {
          "type": "If",
          "expression": {
            "or": [
              {
                "contains": [
                  "@toLower(variables('SenderEmail'))",
                  "noreply"
                ]
              },
              {
                "contains": [
                  "@toLower(variables('SenderEmail'))",
                  "no-reply"
                ]
              },
              {
                "contains": [
                  "@toLower(variables('SenderEmail'))",
                  "donotreply"
                ]
              },
              {
                "contains": [
                  "@toLower(variables('SenderEmail'))",
                  "mailer-daemon"
                ]
              },
              {
                "contains": [
                  "@toLower(variables('SenderEmail'))",
                  "newsletter"
                ]
              },
              {
                "contains": [
                  "@toLower(variables('EmailSubject'))",
                  "unsubscribe"
                ]
              }
            ]
          },
          "actions": {
            "Terminate_AutoMail": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {
              "Get_Absender_Historie": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['shared_office365']['connectionId']"
                    }
                  },
                  "method": "get",
                  "path": "/v2/Mail",
                  "queries": {
                    "folderPath": "Inbox",
                    "from": "@variables('SenderEmail')",
                    "fetchOnlyUnread": false,
                    "top": 5,
                    "importance": "Any"
                  }
                },
                "runAfter": {}
              },
              "Get_Kalender_Events": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['shared_office365']['connectionId']"
                    }
                  },
                  "method": "get",
                  "path": "/datasets/calendars/tables/calendar/items",
                  "queries": {
                    "$top": 3,
                    "$orderby": "start/dateTime desc"
                  }
                },
                "runAfter": {
                  "Get_Absender_Historie": ["Succeeded", "Failed"]
                }
              },
              "Call_Claude_API": {
                "type": "Http",
                "inputs": {
                  "method": "POST",
                  "uri": "https://api.anthropic.com/v1/messages",
                  "headers": {
                    "x-api-key": "@variables('AnthropicApiKey')",
                    "anthropic-version": "2023-06-01",
                    "content-type": "application/json"
                  },
                  "body": {
                    "model": "claude-opus-4-7",
                    "max_tokens": 1024,
                    "system": "Du bist der MAIL-Agent, Subagent von KIJA, dem persoenlichen Assistenten von Rolf Mueller (Partner MUELLER PAPARIS AG, Zuerich). Klassifiziere eingehende E-Mails und entwirf wenn noetig eine Antwort im Stil von Rolf. Antworte AUSSCHLIESSLICH mit gueltigem JSON ohne Fliesstext. STIL: Schweizer Hochdeutsch (ss statt ss), Konjunktiv fuer juristische Aussagen, 'gerne' als Einstiegswort, 'Office' statt Sekretariat. ANREDE: Gericht='Sehr geehrter Herr Praesident + Geschaetztes Gericht', Mandant neu='Sehr geehrter Herr/Frau X', Mandant vertraut='Lieber Vorname', Kollege='Sehr geehrter Herr Kollege'. SCHLUSS: Gericht='kollegialiter', Mandant formell='Freundliche Gruesse' oder 'Besten Dank fuer Ihre Kenntnisnahme.', intern='glg'. OUTPUT JSON: {\"action\":\"ignore|notify|draft|urgent\",\"reasoning\":\"ein Satz\",\"category\":\"mandant|gericht|kollegen|admin|spam|newsletter\",\"priority\":1,\"draft_subject\":\"Re:...\",\"draft_body\":\"...\",\"open_questions\":[]}",
                    "messages": [
                      {
                        "role": "user",
                        "content": "@{concat('Neue E-Mail.\nVON: ', variables('SenderEmail'), '\nBETREFF: ', variables('EmailSubject'), '\nINHALT:\n', variables('EmailBody'), '\n\nKONTEXT:\n- Fruehere Mails von diesem Absender: ', string(length(body('Get_Absender_Historie')?['value'])), '\n- Kalender-Termine: ', string(length(body('Get_Kalender_Events')?['value'])))}"
                      }
                    ]
                  }
                },
                "runAfter": {
                  "Get_Kalender_Events": ["Succeeded", "Failed"]
                }
              },
              "Parse_Claude_Response": {
                "type": "ParseJson",
                "inputs": {
                  "content": "@body('Call_Claude_API')?['content']?[0]?['text']",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string"
                      },
                      "reasoning": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "priority": {
                        "type": "integer"
                      },
                      "draft_subject": {
                        "type": "string"
                      },
                      "draft_body": {
                        "type": "string"
                      },
                      "open_questions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Call_Claude_API": ["Succeeded"]
                }
              },
              "Ignore_Filter": {
                "type": "If",
                "expression": {
                  "less": [
                    "@body('Parse_Claude_Response')?['priority']",
                    3
                  ]
                },
                "actions": {
                  "Terminate_LowPriority": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Succeeded"
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Post_Teams_Adaptive_Card": {
                      "type": "ApiConnection",
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['shared_teams']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/v1.0/teams/conversation/adaptivecard/poster/Flow bot/location/@{encodeURIComponent('Channel')}",
                        "body": {
                          "recipient": {
                            "groupId": "DEINE_TEAMS_GRUPPE_ID",
                            "channelId": "DEIN_TEAMS_KANAL_ID"
                          },
                          "messageBody": "@{concat('{\"$schema\":\"http://adaptivecards.io/schemas/adaptive-card.json\",\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"TextBlock\",\"text\":\"', if(greaterOrEquals(body('Parse_Claude_Response')?['priority'], 4), '🔴', if(equals(body('Parse_Claude_Response')?['priority'], 3), '🟡', '🟢')), ' Neue E-Mail — Prioritaet ', string(body('Parse_Claude_Response')?['priority']), '/5\",\"weight\":\"Bolder\",\"size\":\"Large\"},{\"type\":\"FactSet\",\"facts\":[{\"title\":\"Von:\",\"value\":\"', variables('SenderEmail'), '\"},{\"title\":\"Betreff:\",\"value\":\"', replace(variables('EmailSubject'), '\"', ''), '\"},{\"title\":\"Kategorie:\",\"value\":\"', body('Parse_Claude_Response')?['category'], '\"},{\"title\":\"Empfehlung:\",\"value\":\"', body('Parse_Claude_Response')?['action'], '\"}]},{\"type\":\"TextBlock\",\"text\":\"', replace(body('Parse_Claude_Response')?['reasoning'], '\"', ''), '\",\"wrap\":true}]}')}"
                        }
                      },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": {
                  "Parse_Claude_Response": ["Succeeded"]
                }
              }
            }
          },
          "runAfter": {
            "Init_EmailBody": ["Succeeded"]
          }
        }
      }
    }
  }
}
